# ─── Server (Vercel env dashboard + `vercel env pull`; NEVER commit real values) ───
# Neon Postgres pooled connection string (server-only: API routes + scripts).
NEON_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require
# OpenAI key for server-side recommendations + AI Doctor (server-only).
OPENAI_API_KEY=sk-your-key
# Optional: Resend key to enable forgot-password emails. Without it /api/auth/forgot answers 503.
RESEND_API_KEY=
RESET_FROM_EMAIL=MindTrace <no-reply@mindtrace.ai>
# Google OAuth web client ID (Google Cloud → Credentials). Server verifies
# audience against this; the app uses it with the Expo auth proxy.
GOOGLE_OAUTH_CLIENT_ID=

# ─── Client (EXPO_PUBLIC_* is bundled into the app — safe to expose) ───
# Base URL of the Vercel deployment. Web production can omit (same-origin /api).
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
# Google OAuth web client ID (same value as above) for the app's sign-in button.
# Optional platform overrides for dev-build scheme redirects:
# EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID / _IOS / _WEB
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Design reference
STITCH_PROJECT_ID=projects/16828359225812598247
